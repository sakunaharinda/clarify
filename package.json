{
  "name": "clarify",
  "displayName": "Clarify",
  "description": "AI-powered inline code explanations using OpenAI.",
  "publisher": "sakunaharinda",
  "version": "0.0.1",
  "license": "MIT",
  "icon": "assets/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/sakunaharinda/clarify"
  },
  "keywords": [
    "ai",
    "code explanation",
    "inline comments",
    "productivity"
  ],
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "clarify.explain",
        "title": "Explain Selected Code",
        "category": "Clarify"
      },
      {
        "command": "clarify.insertComment",
        "title": "Insert Explanation as Comment",
        "category": "Clarify"
      },
      {
        "command": "clarify.openSettings",
        "title": "Open Settings",
        "category": "Clarify"
      }
    ],
    "keybindings": [
      {
        "command": "clarify.explain",
        "key": "shift+e",
        "when": "editorHasSelection && editorTextFocus"
      }
    ],
    "configuration": {
      "title": "Clarify",
      "properties": {
        "clarify.openaiApiKey": {
          "type": "string",
          "default": "",
          "markdownDescription": "Your OpenAI API key (`sk-...`). **Note:** stored as plain text in settings.json.",
          "order": 1
        },
        "clarify.model": {
          "type": "string",
          "default": "gpt-4o",
          "enum": [
            "gpt-4o",
            "gpt-4o-mini",
            "gpt-4-turbo",
            "gpt-3.5-turbo"
          ],
          "enumDescriptions": [
            "GPT-4o — best quality, recommended",
            "GPT-4o Mini — faster and cheaper, good for most code",
            "GPT-4 Turbo — previous generation flagship",
            "GPT-3.5 Turbo — fastest and cheapest, basic explanations"
          ],
          "description": "OpenAI model to use for generating explanations.",
          "order": 2
        }
      }
    },
    "menus": {
      "editor/context": [
        {
          "command": "clarify.insertComment",
          "when": "editorHasSelection",
          "group": "codeExplainer@1"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.125.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "typescript-eslint": "^8.56.1",
    "eslint": "^9.39.3",
    "typescript": "^5.9.3",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2"
  }
}
